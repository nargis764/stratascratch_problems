WITH cte1 AS (
SELECT value,
TO_CHAR(created_at, 'YYYY-MM') AS year_month
FROM sf_transactions
),
cte2 AS (
SELECT year_month,
SUM(value) AS total_revenue
FROM cte1
GROUP BY year_month
)
SELECT year_month,
100*((total_revenue - LAG(total_revenue) OVER(ORDER BY year_month))/LAG(total_revenue) OVER(ORDER BY year_month)) AS revenue_diff_pct
FROM cte2
ORDER BY year_month
