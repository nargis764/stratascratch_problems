WITH CTE1 AS (
select country,
date_part('month', created_at) AS month,
DENSE_RANK() OVER(PARTITION BY date_part('month', created_at) ORDER BY sum(number_of_comments) DESC) AS country_rank
from fb_comments_count
JOIN fb_active_users 
ON fb_active_users.user_id = fb_comments_count.user_id
WHERE created_at >= '2019-12-01' AND created_at < '2020-02-01'
GROUP BY country, month
