WITH cte AS (
SELECT user_id,
record_date AS ct_date, 
LAG(record_date) OVER(PARTITION BY user_id ORDER BY record_date) as prev_date,
LEAD(record_date) OVER(PARTITION BY user_id ORDER BY record_date) as next_date
FROM sf_events
)
SELECT DISTINCT user_id
FROM cte
WHERE ct_date - prev_date = 1 and next_date - ct_date = 1;
